// Source — Pandoc template for Typst (A4 PDF, e.g. meeting notes for clients)
// Headings: Source Serif 4 · Body: Source Sans 3 · Code: Source Code Pro
// Colors match zettlr/source-zettlr.css. Fonts are expected via --font-path typst/fonts.
// Noto Emoji (monochrome) is the fallback for emoji and symbols, so they take
// the text color and weight.
//
// Metadata (all optional): title, subtitle, client, date, author, lang,
// logo (image path, shown next to the title), logo-height (maximum height,
// default 20mm).
// The date appears only when set. Mermaid code blocks are drawn
// with the bundled mmdr package (--package-cache-path typst/packages).

#let text-color = rgb("#2b2b2b")
#let muted = rgb("#6b6b6b")
#let heading-color = rgb("#1a1a1a")
#let accent = rgb("#b5452b")
#let border = rgb("#e4e1dc")
#let code-bg = rgb("#f4f2ee")

#let font-emoji = "Noto Emoji"
#let font-serif = ("Source Serif 4", font-emoji)
#let font-sans = ("SourceSans3VF", font-emoji)
#let font-mono = ("SourceCodeVF", font-emoji)

#import "@preview/mmdr:0.2.2": mermaid-svg

// Labels in the document language (de, otherwise en)
#let doc-lang = "$if(lang)$$lang$$else$de$endif$".slice(0, 2)
#let labels = (
  de: (page: "Seite", diagram: "Diagramm"),
  en: (page: "Page", diagram: "Diagram"),
)
#let label-text(key) = labels.at(doc-lang, default: labels.en).at(key)

// Helpers referenced by Pandoc's Typst writer
// (newer Pandoc versions call divider(), older ones use horizontalrule)
#let divider() = block(above: 1.6em, below: 1.6em, line(length: 100%, stroke: 0.6pt + border))
#let horizontalrule = divider()

#show figure.where(kind: table): set figure.caption(position: $if(table-caption-position)$$table-caption-position$$else$top$endif$)
#show figure.where(kind: image): set figure.caption(position: $if(figure-caption-position)$$figure-caption-position$$else$bottom$endif$)

$if(highlighting-definitions)$
$highlighting-definitions$

$endif$
#let doc-title = $if(title)$[$title$]$else$none$endif$
#let doc-client = $if(client)$[$client$]$else$none$endif$
#let doc-subtitle = $if(subtitle)$[$subtitle$]$else$none$endif$
#let doc-date = $if(date)$[$date$]$else$none$endif$
#let doc-author = $if(author)$[$for(author)$$author$$sep$, $endfor$]$else$none$endif$
#let doc-logo-path = $if(logo-path)$$logo-path$$else$none$endif$
// The logo keeps its proportions and fits into 20mm height and 60mm width
#let logo-max-height = $if(logo-height)$$logo-height$$else$20mm$endif$
#let logo-max-width = 60mm
#let doc-logo = if doc-logo-path != none {
  context {
    let natural = measure(image(doc-logo-path))
    let scale = calc.min(logo-max-width / natural.width, logo-max-height / natural.height)
    image(doc-logo-path, width: natural.width * scale, alt: "Logo")
  }
}

#set document(
$if(title)$
  title: [$title$],
$elseif(pdf-title)$
  title: [$pdf-title$],
$endif$
$if(author)$
  author: ($for(author)$"$author$"$sep$, $endfor$),
$endif$
)

#set page(
  paper: "$if(papersize)$$papersize$$else$a4$endif$",
  margin: (top: 24mm, bottom: 26mm, x: 22mm),
  footer: context {
    set text(size: 8.5pt, fill: muted)
    line(length: 100%, stroke: 0.5pt + border)
    v(-4pt)
    grid(
      columns: (1fr, auto),
      // At most two of client, title and subtitle, in this order
      {
        let parts = (doc-client, doc-title, doc-subtitle).filter(p => p != none)
        parts.slice(0, calc.min(2, parts.len())).join([ · ])
      },
      [#label-text("page") #counter(page).display() / #counter(page).final().first()],
    )
  },
)

#set text(
  font: font-sans,
  size: 11pt,
  fill: text-color,
  lang: "$if(lang)$$lang$$else$de$endif$",
  hyphenate: true,
  // Old-style figures in running text; tables and code switch to lining.
  number-type: "old-style",
  number-width: "proportional",
)
#set par(leading: 0.7em, spacing: 1.4em)

$if(smart)$
$else$
#set smartquote(enabled: false)

$endif$
// Headings: "#" in the note is the first section level; the document title
// comes from the front matter (see source.lua for notes without "title:").

// Headings stay light: the serif already sets them apart from the sans text
#show heading: set text(font: font-serif, fill: heading-color, weight: 400)
#show heading: set block(sticky: true)
// Sizes: title 18pt, level 1 15pt, level 2 13pt, from level 3 on the body
// size of 11pt
#show heading.where(level: 1): set text(size: 15pt)
#show heading.where(level: 1): set block(above: 2em, below: 0.8em)
#show heading.where(level: 2): set text(size: 13pt)
#show heading.where(level: 2): set block(above: 1.6em, below: 0.7em)
#show heading.where(level: 3): set text(size: 11pt, weight: 500)
#show heading.where(level: 3): set block(above: 1.4em, below: 0.6em)
#show heading.where(level: 4): set text(size: 11pt, style: "italic")
#show heading.where(level: 4): set block(above: 1.3em, below: 0.6em)
#show heading.where(level: 5): set text(size: 11pt, style: "italic", weight: 400, fill: muted)
#show heading.where(level: 6): set text(size: 11pt, style: "italic", weight: 400, fill: muted)

// Text elements

#show link: set text(fill: accent)
#show strong: set text(weight: 700, fill: heading-color)
#show highlight: set highlight(fill: rgb("#fbeab0"))

#set list(indent: 0.3em, body-indent: 0.6em, marker: ([•], [–]))
#set enum(indent: 0.3em, body-indent: 0.6em)
#set terms(hanging-indent: 1.5em)

// Task lists: Pandoc writes ☐ / ☒, drawn here as boxes
#let task-box(done) = box(
  width: 0.8em,
  height: 0.8em,
  baseline: 0.1em,
  radius: 1.5pt,
  stroke: 0.7pt + muted,
  fill: if done { accent } else { none },
  if done { align(center + horizon, text(fill: white, size: 0.65em, weight: 700)[✓]) },
)
#show "☐": task-box(false)
#show "☒": task-box(true)

// A list item starting with ☐ / ☒: its state and the text after the box
#let task-parts(body) = {
  let children = if body.has("children") { body.children } else { (body,) }
  if children.len() == 0 { return none }
  let first = children.first()
  if first.func() != text { return none }
  for mark in ("☐", "☒") {
    if first.text.starts-with(mark) {
      let rest = first.text.trim(mark, at: start).trim(at: start)
      return (done: mark == "☒", body: (text(rest),) + children.slice(1))
    }
  }
  none
}

// Lists with task items: the box replaces the bullet of those items, and
// wrapped lines align with the text. It stays a real list, so the PDF keeps
// its list structure.
#show list: it => {
  let tasks = it.children.map(item => task-parts(item.body))
  if tasks.all(task => task == none) { return it }
  list(
    marker: [],
    indent: 0.2em,
    body-indent: 0pt,
    spacing: if it.tight { auto } else { it.spacing },
    ..it.children.zip(tasks).map(((item, task)) => list.item(grid(
      // Text starts where it does in plain lists (indent + bullet + gap)
      columns: (1.05em, 1fr),
      if task == none { h(0.1em) + [•] } else { task-box(task.done) },
      if task == none { item.body } else { task.body.join() },
    ))),
  )
}

// Alerts (> [!NOTE] …), emitted by source.lua
#let alert-colors = (
  note: rgb("#2f6aa8"),
  tip: rgb("#3b7d3a"),
  important: rgb("#7a4fb0"),
  warning: rgb("#b05a1a"),
  caution: rgb("#b5452b"),
)
#let alert(kind, title, body) = {
  let color = alert-colors.at(kind, default: accent)
  block(
    width: 100%,
    fill: color.lighten(93%),
    stroke: (left: 2.5pt + color),
    radius: (right: 3pt),
    inset: (left: 12pt, right: 10pt, y: 8pt),
    above: 1.2em,
    below: 1.2em,
    {
      text(size: 0.8em, weight: 700, tracking: 0.06em, fill: color, upper(title))
      v(0.1em)
      body
    },
  )
}

#show quote.where(block: true): it => block(
  stroke: (left: 2pt + accent),
  inset: (left: 12pt, y: 3pt),
  above: 1.2em,
  below: 1.2em,
  text(font: font-serif, style: "italic", fill: muted, it.body),
)

// Code

#show raw: set text(font: font-mono, size: 0.88em, number-type: auto, number-width: auto)
// Syntax colors from the palette as an embedded TextMate theme
// (Typst cannot read files outside the temporary document's folder)
#set raw(theme: bytes("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>name</key><string>Source</string>\n  <key>settings</key>\n  <array>\n    <dict><key>settings</key><dict>\n      <key>foreground</key><string>#2b2b2b</string>\n      <key>background</key><string>#f4f2ee</string>\n    </dict></dict>\n    <dict><key>scope</key><string>comment, punctuation.definition.comment</string>\n      <key>settings</key><dict><key>foreground</key><string>#736b60</string><key>fontStyle</key><string>italic</string></dict></dict>\n    <dict><key>scope</key><string>string, punctuation.definition.string</string>\n      <key>settings</key><dict><key>foreground</key><string>#4f7a28</string></dict></dict>\n    <dict><key>scope</key><string>constant.numeric, constant.language, constant.character</string>\n      <key>settings</key><dict><key>foreground</key><string>#b5452b</string></dict></dict>\n    <dict><key>scope</key><string>keyword, storage, keyword.control.import</string>\n      <key>settings</key><dict><key>foreground</key><string>#a3337a</string></dict></dict>\n    <dict><key>scope</key><string>keyword.operator</string>\n      <key>settings</key><dict><key>foreground</key><string>#6b6b6b</string></dict></dict>\n    <dict><key>scope</key><string>entity.name.function, support.function, meta.function-call</string>\n      <key>settings</key><dict><key>foreground</key><string>#1f5f99</string></dict></dict>\n    <dict><key>scope</key><string>entity.name.type, entity.name.class, support.type, support.class, storage.type</string>\n      <key>settings</key><dict><key>foreground</key><string>#1f6f6a</string></dict></dict>\n    <dict><key>scope</key><string>entity.name.tag, entity.other.attribute-name, meta.preprocessor, variable.parameter</string>\n      <key>settings</key><dict><key>foreground</key><string>#8a5a00</string></dict></dict>\n  </array>\n</dict>\n</plist>\n"))
#show raw.where(block: false): it => box(
  fill: code-bg,
  inset: (x: 3pt),
  outset: (y: 3pt),
  radius: 2pt,
  it,
)
#show raw.where(block: true): it => block(
  width: 100%,
  fill: code-bg,
  stroke: 0.5pt + border,
  radius: 4pt,
  inset: 10pt,
  text(size: 0.95em, it),
)

// Tables

#set table(
  inset: (x: 8pt, y: 6pt),
  stroke: (_, y) => (
    top: if y == 0 { 0.8pt + text-color } else { none },
    bottom: if y == 0 { 0.8pt + text-color } else { 0.5pt + border },
  ),
)
#show table.cell.where(y: 0): set text(weight: 600)
// Pandoc wraps tables in align(center); keep them and their cells left-aligned
#show figure.where(kind: table): it => {
  show align: a => a.body
  set align(start)
  it
}
#show table: set text(number-type: "lining", number-width: "tabular")
// Long tables continue on the next page, with their header repeated
#show figure.where(kind: table): set block(breakable: true)

// Images

#show figure.where(kind: image): set block(above: 1.4em, below: 1.4em)
#show figure.caption: set text(size: 0.9em, fill: muted)

// Mermaid diagrams (```mermaid code blocks)

#let mermaid-theme = (
  // Static Regular: SVG text cannot use the variable font's weights
  font_family: "Source Sans 3",
  primary_color: "#f4f2ee",
  primary_text_color: "#2b2b2b",
  primary_border_color: "#b9b2a6",
  secondary_color: "#fbeab0",
  tertiary_color: "#fdfcfa",
  line_color: "#6b6b6b",
  text_color: "#2b2b2b",
  edge_label_background: "#ffffff",
  cluster_background: "#fdfcfa",
  cluster_border: "#e4e1dc",
  background: "#ffffff",
  sequence_actor_fill: "#f4f2ee",
  sequence_actor_border: "#b9b2a6",
  sequence_actor_line: "#b9b2a6",
  sequence_note_fill: "#fbeab0",
  sequence_note_border: "#e0c66a",
)
#show raw.where(lang: "mermaid", block: true): it => block(
  width: 100%,
  above: 1.4em,
  below: 1.4em,
  {
    set text(font: font-sans, number-type: auto, number-width: auto)
    let svg = mermaid-svg(it.text, base-theme: "modern", theme: mermaid-theme)
    align(center, image(bytes(svg), format: "svg", alt: label-text("diagram")))
  },
)

$for(header-includes)$
$header-includes$

$endfor$
// Title block

#let title-block = {
  if doc-client != none {
    text(size: 9pt, fill: muted, tracking: 0.08em, upper(doc-client))
    v(0.2em)
  }
  if doc-title != none {
    block(below: 1em, par(leading: 0.4em, text(font: font-serif, size: 18pt, weight: 500, fill: heading-color, doc-title)))
  }
$if(subtitle)$
  block(below: 0.4em, text(font: font-serif, size: 13pt, fill: muted)[$subtitle$])
$endif$
  // Date and author line, only with what is set
  let meta-line = (doc-date, doc-author).filter(p => p != none)
  if meta-line.len() > 0 {
    text(size: 9.5pt, fill: muted, meta-line.join([ · ]))
  }
}
#if doc-logo == none {
  title-block
} else {
  grid(
    columns: (1fr, auto),
    column-gutter: 16pt,
    align: (left + top, right + top),
    title-block, doc-logo,
  )
}
#v(0.3em)
#line(length: 100%, stroke: 0.8pt + border)

$for(include-before)$
$include-before$

$endfor$
$if(toc)$
#outline(title: auto, depth: $toc-depth$)

$endif$
$body$

$for(include-after)$
$include-after$

$endfor$
