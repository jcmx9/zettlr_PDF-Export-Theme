# ZETTLR DEFAULTS FILE
# ====================
# Conversion: Markdown --> PDF via Typst with the Source layout
# Generated by scripts/install-zettlr.sh from the Typora_Theme-Source repo.
# More info: https://pandoc.org/MANUAL.html
#
# - "# Title" becomes the document title, "## Section" the first level
# - Every line break in the note is kept (hard_line_breaks)
# - ==highlight==, > [!NOTE] alerts and typographic quotes are supported
# - Front matter (optional): client, date, subtitle, author
reader: markdown+hard_line_breaks+mark+alerts-smart
writer: pdf
standalone: true
pdf-engine: "@TYPST@"
pdf-engine-opts:
  - --ignore-system-fonts
  - "--font-path=@REPO@/typst/fonts"
template: "@REPO@/typst/source.typst"
filters:
  - type: lua
    path: "@REPO@/typst/source.lua"
shift-heading-level-by: -1
variables:
  papersize: a4
  lang: de
metadata-files: []
include-before-body: []
include-after-body: []
include-in-header: []
