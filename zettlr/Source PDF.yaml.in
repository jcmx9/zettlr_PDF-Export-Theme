# ZETTLR DEFAULTS FILE
# ====================
# Conversion: Markdown --> PDF with real-fast-document (rf-document)
# Written by the zettlr_PDF-Export-Theme installer; reinstalling overwrites it.
# More info: https://github.com/jcmx9/real-fast-document
#
# Pandoc only hands the note to rf-document (see the Lua filter), which sets
# layout, fonts and PDF/A. The PDF engine below is never started; Pandoc only
# needs a valid name for a PDF profile.
reader: commonmark_x
writer: pdf
pdf-engine: typst
filters:
  - type: lua
    path: '@DIR@/zettlr/rf-document.lua'
metadata-files: []
include-before-body: []
include-after-body: []
include-in-header: []
